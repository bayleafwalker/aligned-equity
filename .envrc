repo_root="${DIRENV_DIR#-}"
if [ -z "${repo_root}" ] || [ "${repo_root}" = "${DIRENV_DIR}" ]; then
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

export SPRINTCTL_DB="${repo_root}/.sprintctl/sprintctl.db"

# sprintctl runs in served mode against the Vuoro work adapter (backfilled
# into vuoro-shared 2026-07-24 -- see sprintctl
# docs/plans/1164-gate-evidence-ledger.md). Direct PostgreSQL credentials
# are no longer the default path; the commented block below is the
# rollback (pre-served-mode-backfill direct-remote) path.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
unset SPRINTCTL_URL

# Host-specific overrides belong in .envrc.local (gitignored), sourced last
# so it can override any export above.
if [ -f "${repo_root}/.envrc.local" ]; then
  # shellcheck disable=SC1091
  . "${repo_root}/.envrc.local"
fi

# Rollback path (direct PostgreSQL, pre-served-mode-backfill): uncomment
# and flip .sprintctl/backend.json's "backend" back to "remote" if served
# mode is unavailable.
