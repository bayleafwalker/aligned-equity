repo_root="${DIRENV_DIR#-}"
if [ -z "${repo_root}" ] || [ "${repo_root}" = "${DIRENV_DIR}" ]; then
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

export SPRINTCTL_DB="${repo_root}/.sprintctl/sprintctl.db"
export SPRINTCTL_BACKEND=remote

# Workstation fallback: derive the URI from the CNPG application Secret with
# the sprintctl-pg LoadBalancer address substituted in (canonical pattern in
# /projects/dev/sprintctl/.envrc). Devbox injects SPRINTCTL_URL via pod env.
if [ -z "${SPRINTCTL_URL:-}" ]; then
  appservice_kubeconfig=/projects/dev/appservice/clusters/.kube/config
  if [ -r "$appservice_kubeconfig" ] && command -v kubectl >/dev/null && command -v base64 >/dev/null; then
    sprintctl_uri_b64=$(KUBECONFIG="$appservice_kubeconfig" kubectl -n vscode get secret sprintctl-cnpg-main-app -o jsonpath='{.data.uri}' 2>/dev/null || true)
    sprintctl_lan_host=$(KUBECONFIG="$appservice_kubeconfig" kubectl -n vscode get service sprintctl-pg -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)
    if [ -n "$sprintctl_uri_b64" ] && [ -n "$sprintctl_lan_host" ]; then
      sprintctl_uri=$(printf '%s' "$sprintctl_uri_b64" | base64 --decode)
      export SPRINTCTL_URL="${sprintctl_uri/sprintctl-cnpg-main-rw.vscode/$sprintctl_lan_host}"
      unset sprintctl_uri
    fi
    unset sprintctl_uri_b64 sprintctl_lan_host
  fi
fi

export SPRINTCTL_URL="${SPRINTCTL_URL:?Set SPRINTCTL_URL from an injected secret, or configure appservice Kubernetes access, before entering this repo}"
export KCTL_DB="${repo_root}/.kctl/kctl.db"
export KCTL_PROJECT="aligned-equity"
