{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aligned-equity.local/schemas/decision-output.schema.json",
  "title": "Aligned Equity Decision Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "analysis_date",
    "decision_context",
    "current_research_state",
    "material_evidence_ids",
    "scorecard_dimension_assessments",
    "confidence_summary",
    "comparability_summary",
    "likely_action_implication",
    "value_of_information_assessment",
    "value_of_information_note",
    "causal_claim"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_date": {
      "type": "string",
      "format": "date"
    },
    "decision_context": {
      "type": "string",
      "enum": ["investment", "workplace", "product"]
    },
    "current_research_state": {
      "type": "string",
      "enum": [
        "long_term_candidate",
        "dislocation_candidate",
        "watch",
        "thesis_strengthened",
        "thesis_weakened",
        "deteriorating",
        "avoid"
      ]
    },
    "material_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scorecard_dimension_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "assessment", "rationale", "evidence_ids"],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "enum": [
              "strong_negative",
              "negative",
              "neutral",
              "positive",
              "strong_positive",
              "insufficient_evidence"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "confidence_summary": {
      "type": "string",
      "minLength": 1
    },
    "comparability_summary": {
      "type": "string",
      "minLength": 1
    },
    "likely_action_implication": {
      "type": "string",
      "minLength": 1
    },
    "value_of_information_assessment": {
      "type": "string",
      "enum": [
        "collect_more_evidence",
        "monitor_freshness",
        "more_research_unlikely_to_change_action"
      ]
    },
    "value_of_information_note": {
      "type": "string",
      "minLength": 1
    },
    "causal_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type"],
      "properties": {
        "claim_type": {
          "type": "string",
          "enum": [
            "association",
            "warning_signal",
            "decision_relevance",
            "causal_effect"
          ]
        },
        "causal_design": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "causal_effect"
              }
            },
            "required": ["claim_type"]
          },
          "then": {
            "required": ["causal_design"]
          }
        }
      ]
    }
  }
}
