{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aligned-equity.local/schemas/source-ledger-record.schema.json",
  "title": "Aligned Equity Source Ledger Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_family",
    "source_name",
    "source_locator",
    "publisher",
    "retrieval_method",
    "collected_at",
    "observed_at",
    "freshness_as_of",
    "expected_update_frequency",
    "freshness_status",
    "language",
    "source_confidence",
    "extraction_readiness",
    "same_firm_comparable",
    "cross_firm_comparable",
    "comparability_notes",
    "bias_flags"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "source_family": {
      "type": "string",
      "enum": [
        "company_ir_annual_reporting",
        "nasdaq_helsinki_announcements",
        "finnish_securities_market_association",
        "fin_fsa_supervision",
        "prh_trade_register",
        "presentations_transcripts_capital_markets_days",
        "business_media_analyst_coverage",
        "people_platforms"
      ]
    },
    "source_name": { "type": "string", "minLength": 1 },
    "source_locator": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "retrieval_method": {
      "type": "string",
      "enum": ["manual", "download", "registry_api", "vendor_feed", "fixture"]
    },
    "retrieval_notes": { "type": "string", "minLength": 1 },
    "collected_at": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 1 },
    "freshness_as_of": { "type": "string", "minLength": 1 },
    "expected_update_frequency": {
      "type": "string",
      "enum": ["annual", "quarterly", "event-driven", "irregular", "one-off", "unknown"]
    },
    "freshness_status": {
      "type": "string",
      "enum": ["current", "stale", "unknown", "not-applicable"]
    },
    "coverage_start": { "type": "string", "minLength": 1 },
    "coverage_end": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "source_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "extraction_readiness": {
      "type": "string",
      "enum": ["ready", "manual-review-required", "not-ready"]
    },
    "same_firm_comparable": {
      "type": "string",
      "enum": ["yes", "partial", "no"]
    },
    "cross_firm_comparable": {
      "type": "string",
      "enum": ["yes", "partial", "no"]
    },
    "comparability_notes": { "type": "string", "minLength": 1 },
    "bias_flags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "raw_hash": { "type": "string", "minLength": 1 },
    "derived_evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
