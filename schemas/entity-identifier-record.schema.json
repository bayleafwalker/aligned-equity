{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aligned-equity.local/schemas/entity-identifier-record.schema.json",
  "title": "Aligned Equity Entity Identifier Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "display_name",
    "domicile_country",
    "identifier_confidence",
    "company_identifiers",
    "source_aliases",
    "normalization_notes"
  ],
  "properties": {
    "company_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "legal_name": { "type": "string", "minLength": 1 },
    "domicile_country": { "type": "string", "minLength": 2 },
    "identifier_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "company_identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "type": "string", "minLength": 1 },
        "lei": { "type": "string", "minLength": 1 },
        "prh_trade_register_number": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "security_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["security_id", "listing_status"],
        "properties": {
          "security_id": { "type": "string", "minLength": 1 },
          "isin": { "type": "string", "minLength": 1 },
          "ticker": { "type": "string", "minLength": 1 },
          "market": { "type": "string", "minLength": 1 },
          "mic": { "type": "string", "minLength": 1 },
          "currency": { "type": "string", "minLength": 1 },
          "listing_status": {
            "type": "string",
            "enum": ["listed", "delisted", "unknown"]
          }
        }
      },
      "uniqueItems": true
    },
    "source_aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_family", "source_value"],
        "properties": {
          "source_family": {
            "type": "string",
            "enum": [
              "company_ir_annual_reporting",
              "nasdaq_helsinki_announcements",
              "finnish_securities_market_association",
              "fin_fsa_supervision",
              "prh_trade_register",
              "presentations_transcripts_capital_markets_days",
              "business_media_analyst_coverage",
              "people_platforms"
            ]
          },
          "source_value": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 }
        }
      },
      "uniqueItems": true
    },
    "normalization_notes": { "type": "string", "minLength": 1 }
  }
}
